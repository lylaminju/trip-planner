# Copy to .env.local and fill in your own values.
#   cp .env.example .env.local

# --- Supabase (required) ---------------------------------------------------
# Runtime data and auth. Use a server-only secret key; never expose it in
# browser code. Legacy projects may set SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_server_only_secret_key
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key

# --- Google Maps (required) ------------------------------------------------
# Used by the browser map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_google_maps_key

# --- Google Routes (optional) ----------------------------------------------
# Required for real route polylines. Without it the map still renders markers
# and falls back to straight lines. If unset, the server falls back to
# GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_ROUTES_API_KEY=your_server_google_routes_key
# GOOGLE_MAPS_API_KEY=your_server_google_maps_key

# --- Google Places (optional) ----------------------------------------------
# Enables live destination search in the create-trip modal via Places API
# (New). Without it the modal falls back to the free curated destination list.
# Usage is gated to stay inside Google's monthly free tier; also cap the API
# key's per-day quota in Google Cloud Console as a hard money-stop.
GOOGLE_PLACES_API_KEY=your_server_google_places_key

# --- AI itinerary planning (required for AI planning) ----------------------
# Both must be set, or generation fails with a config error.
OPENAI_API_KEY=your_server_openai_key
OPENAI_AI_PLANNER_MODEL=your_chosen_planner_model

# --- Guest mode (optional) -------------------------------------------------
# Signs the anonymous guest cookie for the public no-sign-in demo. Guest mode
# stays disabled while unset. Generate with: openssl rand -hex 32
GUEST_SESSION_SECRET=your_guest_cookie_signing_secret
# Trip id cloned by the "Explore a sample trip" entry point. The clone copies
# cached route geometry, so pick a trip whose routes are already rendered.
GUEST_SAMPLE_TRIP_ID=your_sample_trip_id

# --- Admin (optional) ------------------------------------------------------
# Gates the /admin/usage dashboard to the matching signed-in account.
ADMIN_EMAIL=your_admin_account_email
